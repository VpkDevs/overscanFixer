<Window x:Class="OverscanFix.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overscan Calibration"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#CC0A0E17"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Canvas x:Name="OverlayCanvas" MouseDown="OverlayCanvas_MouseDown">
        <!-- Rendered dynamically in code-behind for exact pixel placement -->
    </Canvas>
</Window>
