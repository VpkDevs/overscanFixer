<Window x:Class="OverscanFix.MaskSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Border Mask Customizer"
        Height="360" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="🎨 Border Mask Appearance" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" />
            <TextBlock Text="Configure solid matte color and transparency for the outside click-through border masks." FontSize="12" Foreground="#94A3B8" />
        </StackPanel>

        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <!-- Color Selector -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mask Color (Hex #RRGGBB):" VerticalAlignment="Center" Foreground="#E2E8F0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border x:Name="ColorSample" Width="24" Height="24" CornerRadius="4" BorderBrush="#475569" BorderThickness="1" Margin="0,0,8,0" Background="Black" />
                        <TextBox x:Name="ColorHexText" Width="80" Text="#000000" TextAlignment="Center" VerticalAlignment="Center" TextChanged="ColorHexText_TextChanged" />
                    </StackPanel>
                </Grid>

                <!-- Color Presets -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Color Presets:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="Pure Black" Click="ColorPreset_Black" Background="#000000" Foreground="White" Padding="8,3" Margin="2,0" BorderThickness="1" BorderBrush="#334155" />
                    <Button Content="Deep Slate" Click="ColorPreset_Slate" Background="#0F172A" Foreground="White" Padding="8,3" Margin="2,0" BorderThickness="1" BorderBrush="#334155" />
                    <Button Content="Dark Blue" Click="ColorPreset_Blue" Background="#030712" Foreground="White" Padding="8,3" Margin="2,0" BorderThickness="1" BorderBrush="#334155" />
                </StackPanel>

                <!-- Opacity Slider -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mask Opacity:" VerticalAlignment="Center" Foreground="#E2E8F0" />
                    <TextBlock x:Name="OpacityValueText" Grid.Column="1" Text="100%" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                </Grid>
                <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" Value="1.0" ValueChanged="OpacitySlider_ValueChanged" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Apply &amp; Close" Click="SaveClose_Click" Background="#3B82F6" Foreground="White" FontWeight="Bold" Padding="16,8" BorderThickness="0" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
